  },
  "dependencies": {
    "@tanstack/react-query": "5.105.3",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "5.105.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.4",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
